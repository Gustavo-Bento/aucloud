{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Infraestrutura AUCloud - Sincronismo e Autorizacao",
  "Parameters": {
    "BucketName": {
      "Type": "String",
      "Default": "sincronismoaws",
      "Description": "Bucket S3 do sincronismo (diagrama: s3://sincronismoaws/estacione). Nomes de bucket são globais; altere se já estiver em uso."
    },
    "CodeBucket": {
      "Type": "String",
      "Description": "Bucket S3 com os .zip das Lambdas (ver scripts/deploy.sh)"
    },
    "SyncS3CodeKey": {
      "Type": "String",
      "Default": "aucloud/syncs3.zip"
    },
    "ConsumerCodeKey": {
      "Type": "String",
      "Default": "aucloud/consumer.zip"
    },
    "EstacioneApiCodeKey": {
      "Type": "String",
      "Default": "aucloud/estacione-api.zip"
    },
    "StageName": {
      "Type": "String",
      "Default": "prod"
    }
  },
  "Resources": {
    "SincronismoBucket": {
      "Type": "AWS::S3::Bucket",
      "DependsOn": "SyncS3InvokePermission",
      "Properties": {
        "BucketName": {
          "Ref": "BucketName"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "NotificationConfiguration": {
          "LambdaConfigurations": [
            {
              "Event": "s3:ObjectCreated:*",
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "estacione/"
                    }
                  ]
                }
              },
              "Function": {
                "Fn::GetAtt": [
                  "SyncS3Lambda",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "StickerErrorQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "AUC-Erros",
        "MessageRetentionPeriod": 1209600
      }
    },
    "StickerLoadQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "UAC-StickerLoad",
        "VisibilityTimeout": 180,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "StickerErrorQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "StickerSyncTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "AUC-StickerSync",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "LogTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "AUC-Log",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "id",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "TokenAuthTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "AUC-TokenAuth",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "token",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "token",
            "KeyType": "HASH"
          }
        ]
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "AUCloudLambdaRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "AUCloudAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadSyncFiles",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${BucketName}/estacione/*"
                  }
                },
                {
                  "Sid": "PublishToQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "StickerLoadQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "ConsumeFromQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "StickerLoadQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "WriteTables",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "StickerSyncTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "LogTable",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Sid": "ReadTokens",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "TokenAuthTable",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "SyncS3Lambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "AUCloud-SyncS3",
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "SyncS3CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "QUEUE_URL": {
              "Ref": "StickerLoadQueue"
            }
          }
        }
      }
    },
    "ConsumerLambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "AUCloud-Consumer",
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "ConsumerCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "STICKER_TABLE": {
              "Ref": "StickerSyncTable"
            },
            "LOG_TABLE": {
              "Ref": "LogTable"
            }
          }
        }
      }
    },
    "EstacioneApiLambda": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "AUCloud-EstacioneAPI",
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "LambdaExecutionRole",
            "Arn"
          ]
        },
        "Timeout": 10,
        "MemorySize": 256,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "EstacioneApiCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TOKEN_TABLE": {
              "Ref": "TokenAuthTable"
            },
            "STICKER_TABLE": {
              "Ref": "StickerSyncTable"
            }
          }
        }
      }
    },
    "SyncS3InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "SyncS3Lambda"
        },
        "Principal": "s3.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:aws:s3:::${BucketName}"
        }
      }
    },
    "SQSTriggerConsumer": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "BatchSize": 10,
        "EventSourceArn": {
          "Fn::GetAtt": [
            "StickerLoadQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "ConsumerLambda"
        },
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ]
      }
    },
    "ApiGateway": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": "AUCloudApi"
      }
    },
    "ApiResourceV1": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "ParentId": {
          "Fn::GetAtt": [
            "ApiGateway",
            "RootResourceId"
          ]
        },
        "PathPart": "v1",
        "RestApiId": {
          "Ref": "ApiGateway"
        }
      }
    },
    "ApiResourceEstacione": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "ParentId": {
          "Ref": "ApiResourceV1"
        },
        "PathPart": "estacione",
        "RestApiId": {
          "Ref": "ApiGateway"
        }
      }
    },
    "ApiGatewayResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "ParentId": {
          "Ref": "ApiResourceEstacione"
        },
        "PathPart": "autoriza",
        "RestApiId": {
          "Ref": "ApiGateway"
        }
      }
    },
    "ApiGatewayMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "ApiGateway"
        },
        "ResourceId": {
          "Ref": "ApiGatewayResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${EstacioneApiLambda.Arn}/invocations"
          }
        }
      }
    },
    "ApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "EstacioneApiLambda"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${ApiGateway}/*/POST/v1/estacione/autoriza"
        }
      }
    },
    "ApiDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": "ApiGatewayMethod",
      "Properties": {
        "RestApiId": {
          "Ref": "ApiGateway"
        }
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGateway::Stage",
      "Properties": {
        "RestApiId": {
          "Ref": "ApiGateway"
        },
        "DeploymentId": {
          "Ref": "ApiDeployment"
        },
        "StageName": {
          "Ref": "StageName"
        },
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 25
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "SincronismoBucket"
      }
    },
    "StickerSyncTable": {
      "Value": {
        "Ref": "StickerSyncTable"
      }
    },
    "ApiId": {
      "Value": {
        "Ref": "ApiGateway"
      }
    },
    "AutorizaUrl": {
      "Value": {
        "Fn::Sub": "https://${ApiGateway}.execute-api.${AWS::Region}.amazonaws.com/${StageName}/v1/estacione/autoriza"
      }
    }
  }
}
